digraph Architecture {
  graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.3", ranksep="0.35", fontname="DejaVu Sans", fontsize=17,
         label="Слоистая архитектура персонального тайм-трекера", labelloc=t];
  node [shape=box, style="rounded,filled", color="#455A64", penwidth=1.2, fontname="DejaVu Sans", fontsize=12, margin="0.18,0.12"];
  edge [color="#455A64", penwidth=1.2, arrowsize=0.8, fontname="DejaVu Sans", fontsize=10];
  App [label="App — точка композиции зависимостей", fillcolor="#EAF2F8"];
  Presentation [label="ПРЕДСТАВЛЕНИЕ\nMainWindow — основное окно\nMiniTimerWindow — мини-панель", fillcolor="#F5F9FC"];
  Application [label="ПРИКЛАДНОЙ СЛОЙ\nTaskService — сценарии задач\nTimerService — State + Observer\nDesktopIntegration — абстракция интеграции с ОС", fillcolor="#F8FAFB"];
  Domain [label="ДОМЕННАЯ МОДЕЛЬ И КОНТРАКТЫ\nCategory · Task · WorkSession · PauseRecord\nCategoryRepository · TaskRepository · WorkSessionRepository", fillcolor="#F5FBF6"];
  Infrastructure [label="ИНФРАСТРУКТУРА\nSQLite JDBC / SqliteDatabase\nAwtDesktopIntegrationAdapter / SystemTray\nNoOpDesktopIntegration — резервный режим", fillcolor="#FAFAFA"];
  Extensions [label="ПОДГОТОВЛЕННЫЕ КОМПОНЕНТЫ ДЛЯ РАСШИРЕНИЯ\nRecommendationService → Strategy\nReportService → Factory Method (CSV / PDF)\nПока не подключены к главному окну", fillcolor="#FCF9FF", style="rounded,dashed,filled", color="#9575CD"];
  App -> Presentation [label="создаёт и связывает"];
  Presentation -> Application [label="вызывает сценарии"];
  Application -> Domain [label="использует модели и контракты"];
  Domain -> Infrastructure [label="контракты реализуются инфраструктурой"];
  {rank=same; Infrastructure; Extensions;}
}
